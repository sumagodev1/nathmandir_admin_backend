# ─────────────────────────────────────────────────────────────
# Environment variables for the Shreenath Gitanjali Admin Backend
# This file is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# MySQL connection (XAMPP defaults: user "root", empty password, port 3306)
DATABASE_URL="mysql://root:@localhost:3306/shreenath_admin"

# Server port
PORT=5000

# Secret used to sign admin login tokens (change to a long random string in production)
JWT_SECRET="shreenath-gitanjali-dev-secret-change-me-2026"

# ── HappySMS OTP gateway (used by src/lib/sms.js) ────────────
# Same gateway/key/template as the old API.php. Rotate the key for production.
SMS_API_URL="http://sms.happysms.in/api/sendhttp.php"
SMS_AUTH_KEY="240394A0j2u3FiF6800cf90P1"
SMS_SENDER="SMGTCH"
SMS_DLT_TEMPLATE_ID="1207174427425038676"
SMS_ROUTE="4"
SMS_COUNTRY="91"

# ── Razorpay (website payment flow) ──────────────────────────
# DEMO/TEST placeholders — replace with the real test keys, then the
# live keys, from the Razorpay dashboard (Settings → API Keys).
# Order creation & payment verification fail cleanly until these are set.
RAZORPAY_KEY_ID="rzp_test_TGtXVBHNq6c69x"
RAZORPAY_KEY_SECRET="DiJrftcJUt2x0YJ3J9GdDLu2"
# Webhook secret (Razorpay dashboard → Webhooks). Optional until webhooks are on.
RAZORPAY_WEBHOOK_SECRET=""

# Short-lived token that authorises checkout after website OTP verify.
CHECKOUT_JWT_EXPIRES="15m"
