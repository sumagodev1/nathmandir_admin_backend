# MySQL connection (XAMPP defaults: user "root", empty password, port 3306)
DATABASE_URL="mysql://root:@localhost:3306/shreenath_admin"

# Server port
PORT=5000

# Secret used to sign admin login tokens (change to a long random string in production)
JWT_SECRET="shreenath-gitanjali-dev-secret-change-me-2026"
