                { "key": "name", "value": "Test Bhakt" },
                { "key": "mobile", "value": "{{mobile}}" },
                { "key": "amount", "value": "251" },
                { "key": "order_id", "value": "order_TEST01" },
                { "key": "payment_request_id", "value": "preq_TEST01" },
                { "key": "payment_status", "value": "Credit" },
                { "key": "partOne", "value": "1" },
                { "key": "partTwo", "value": "0" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/mobile?apicall=save_payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile"],
              "query": [{ "key": "apicall", "value": "save_payment" }]
            }
          }
        },
