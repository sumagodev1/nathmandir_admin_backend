    {
      "name": "Mobile App API",
      "description": "Drop-in replacement for API.php. POST form-urlencoded to /api/mobile?apicall=<op>.\n\nProtected calls need a Bearer token → this folder sends `Authorization: Bearer {{mobileToken}}`, which verifyOTP fills in automatically. PUBLIC (no token): loginuser, verifyOTP, register, admin_login.",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{mobileToken}}", "type": "string" }] },
      "item": [
        {
          "name": "loginuser (send OTP)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [{ "key": "mobile", "value": "{{mobile}}" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/mobile?apicall=loginuser",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile"],
              "query": [{ "key": "apicall", "value": "loginuser" }]
            }
          }
        },
        {
          "name": "verifyOTP (login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('mobileToken', json.token);",
                  "  console.log('Mobile JWT saved to {{mobileToken}}');",
                  "}",
                  "pm.test('verifyOTP returns a token', function () {",
                  "  pm.expect(json.error).to.eql('false');",
                  "  pm.expect(json.token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "mobile", "value": "{{mobile}}" },
                { "key": "otp", "value": "1234", "description": "the OTP from loginuser response" },
                { "key": "DID", "value": "{{deviceId}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/mobile?apicall=verifyOTP",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile"],
              "query": [{ "key": "apicall", "value": "verifyOTP" }]
            }
          }
        },
        {
          "name": "register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Test Bhakt" },
                { "key": "email", "value": "test@example.com" },
                { "key": "mobile", "value": "{{mobile}}" },
                { "key": "city", "value": "Nashik" },
                { "key": "address", "value": "Test Rd" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/mobile?apicall=register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile"],
              "query": [{ "key": "apicall", "value": "register" }]
            }
          }
        },
        {
          "name": "check_status",
          "request": {
            "method": "POST",
