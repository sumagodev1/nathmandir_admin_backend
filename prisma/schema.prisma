// ─────────────────────────────────────────────────────────────
// Prisma schema — Shreenath Gitanjali Admin Backend
// Models mirror the admin panel's data model (src/data/adminData.js).
// Run `npx prisma migrate dev` to create these tables in MySQL.
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────
enum UserStatus {
  active
  disabled
}

enum ContentType {
  audio
  text
}

enum AccessSource {
  purchased // devotee paid (has a matching Sale)
  granted   // admin gave it manually
}

enum GrantDuration {
  d7   // 7 days
  d15  // 15 days
  perm // till revoked
}

enum SaleStatus {
  success
  pending
  failed
}

// When a content item is meant to be played. An item with no schedule rows
// at all is simply unscheduled ("None") — the absence of a row is the
// "none" case, so there is no `none` member here.
enum ContentSession {
  morning
  afternoon
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

// ── Admin (panel login) ──────────────────────────────────────
model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("super_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// ── Product / Module (gita1, gita2, upasana, nithya) ─────────
// `id` is a numeric surrogate key (it lines up with the legacy PHP
// package_id: 1=gita1, 2=gita2, 4=upasana, 5=nithya). `code` is the STABLE
// PUBLIC identifier — the deployed mobile APK and the website checkout both
// send and receive it, so it must never change for an existing module.
model Product {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(191) // e.g. "gita1"
  name      String
  shortName String  @map("short_name")
  price     Int
  active    Boolean @default(true)

  content Content[]
  access  UserAccess[]
  sales   Sale[]
  nodes   ContentNode[]

  @@map("products")
}

// ── User (devotee) ───────────────────────────────────────────
model User {
  id           Int        @id @default(autoincrement())
  name         String
  phone        String // maps to nathmand_db.user.mobile
  city         String
  status       UserStatus @default(active) // maps to nathmand_db.user.active
  registeredOn DateTime   @default(now()) @map("registered_on")
  lastLogin    DateTime?  @map("last_login")
  createdAt    DateTime   @default(now()) @map("created_at")

  // ── Fields added to match the real production nathmand_db.user table ──
  email         String? @default("")
  address       String? @db.Text
  otp           String? @db.VarChar(255)
  isPaid        Int     @default(0) @map("is_paid") // nathmand_db: isPaid
  donation      Int     @default(0) // normal-content donation flag/amount
  donationAudio Int     @default(0) @map("donation_audio") // nathmand_db: donation_audio
  amount        String? @db.Text // last transaction amount (kept as text like source)

  // ── Access Control flags (real access model = flags on the user row) ──
  part1          Int @default(0) @map("part_1") // Gitanjali Part 1 paid
  part2          Int @default(0) @map("part_2") // Gitanjali Part 2 paid
  upasanaPaid    Int @default(0) @map("upasana_paid") // Upasana paid
  nityaniyamPaid Int @default(0) @map("nityaniyam_paid") // Nityaniyam paid

  updatedAt  DateTime? @map("updated_at") // nathmand_db: updatedAt
  updatedAt2 DateTime? @map("updated_at2") // nathmand_db: updatedAt2

  // JWT issued to the mobile app on OTP verify (persisted for session lookup).
  token String? @db.Text

  access UserAccess[]
  sales  Sale[]

  @@index([phone]) // mobile app OTP login + admin search
  @@index([status])
  @@index([registeredOn])
  @@map("users")
}

// ── Content (audio + text per product) ───────────────────────
model Content {
  id        Int         @id @default(autoincrement())
  productId Int         @map("product_id")
  type      ContentType
  title     String
  duration  Int         @default(0) // seconds
  audioUrl  String?     @map("audio_url") @db.Text
  lyrics    String?     @db.Text
  plays     Int         @default(0)
  listeners Int         @default(0)
  published Boolean     @default(true)
  sortOrder Int         @default(0) @map("sort_order")

  // Where the item sits in its Part's hierarchy. NULL means "directly in the
  // Part", which is every item created before the hierarchy existed — those
  // keep working untouched.
  nodeId Int? @map("node_id")

  // Soft delete. NULL = live; a timestamp = in the bin, hidden everywhere but
  // still on disk so a mis-click is recoverable. Nothing cascades from this —
  // the row keeps its section, its schedule and its play count, so restoring
  // puts the item back exactly where it was.
  deletedAt DateTime? @map("deleted_at")

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  schedule ContentSchedule[]
  // SetNull, not Restrict: deleting a Part must be able to cascade through
  // its sections, and a vanished section should leave its items in the Part
  // rather than destroy them. Deleting a non-empty section is refused by the
  // controller, which is where that rule belongs.
  node     ContentNode?      @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, sortOrder]) // matches the list orderBy exactly
  @@index([published])
  @@index([nodeId])
  @@index([deletedAt]) // every list filters on it
  @@map("content")
}

// ── Content hierarchy (a tree of nodes under a Part) ─────────
// One row per node, wherever it sits:
//
//   Gitanjali Part 1 (Product)
//    └── संध्याकाळी      (parent = null)
//         └── वाराची पदे  (parent = संध्याकाळी)
//              └── शुक्रवार (parent = वाराची पदे) → Content items
//
// Nothing in the model names a level. Depth, names and order are all data, so
// one Part can be two levels deep and another five, with different names —
// no code branches on "Morning", "Evening", "Sub Part" or a weekday.
model ContentNode {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  parentId  Int?     @map("parent_id")
  name      String   @db.VarChar(191)
  // Free-text display hint only ("session", "sub part", "day"). Never
  // branched on — it lets the UI label a level without knowing what it means.
  kind      String?  @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  // Hiding a section hides everything filed inside it, at any depth, without
  // touching each item's own `published`. Switching the section back on
  // therefore restores exactly what was showing before.
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Cascade so deleting a Part can remove its whole tree. It never fires from
  // the API: removing a section directly is refused while it holds anything.
  parent   ContentNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children ContentNode[] @relation("NodeChildren")
  content  Content[]

  @@index([productId, parentId, sortOrder])
  @@index([parentId])
  @@map("content_node")
}

// ── When an item is played (Morning / Afternoon × Mon–Sun) ───
// One row per (item, session, day). An item with no rows is unscheduled,
// which is what the form calls "None". Storing it this way rather than as
// two CSV columns keeps "is anything scheduled for Wednesday afternoon?"
// a plain indexed query, and the unique key makes a duplicate tick
// impossible at the database level rather than only in the UI.
model ContentSchedule {
  id        Int            @id @default(autoincrement())
  contentId Int            @map("content_id")
  session   ContentSession
  day       Weekday

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, session, day])
  @@index([contentId])
  @@index([session, day]) // "what plays on Wednesday morning?"
  @@map("content_schedule")
}

// ── User access (purchased vs granted, with expiry) ──────────
model UserAccess {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  productId Int            @map("product_id")
  source    AccessSource
  duration  GrantDuration? // only meaningful for granted access
  grantedOn DateTime       @default(now()) @map("granted_on")
  expiresOn DateTime?      @map("expires_on") // null = permanent / till revoked

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId]) // groupBy productId (listeners, dashboard, content)
  @@index([expiresOn]) // active-vs-expired filtering
  @@map("user_access")
}

// ── Sales / transactions ─────────────────────────────────────
model Sale {
  id        Int        @id @default(autoincrement())
  txnId     String     @unique @map("txn_id")
  userId    Int        @map("user_id")
  productId Int        @map("product_id")
  amount    Int
  status    SaleStatus @default(success)
  ref       String?
  gateway   String     @default("razorpay")
  createdAt DateTime   @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt]) // sales/revenue date-range reports
  @@map("sales")
}

// ── Notifications ────────────────────────────────────────────
model Notification {
  id       Int      @id @default(autoincrement())
  title    String
  message  String   @db.Text
  audience String   @default("all") // "all" or a product code
  reach    Int      @default(0)
  sentOn   DateTime @default(now()) @map("sent_on")

  @@index([sentOn])
  @@index([audience])
  @@map("notifications")
}

// ── Spiritual Library: Books + Chapters ──────────────────────
model Book {
  id          Int     @id @default(autoincrement())
  title       String
  author      String?
  category    String // granth, pothi, stotra
  cover       String? @db.Text
  description String? @db.Text
  published   Boolean @default(false)
  sortOrder   Int     @default(0) @map("sort_order")

  chapters Chapter[]

  @@index([published, category]) // public library listing
  @@index([sortOrder])
  @@map("books")
}

model Chapter {
  id        Int    @id @default(autoincrement())
  bookId    Int    @map("book_id")
  title     String
  content   String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([bookId, sortOrder])
  @@map("chapters")
}

// ── Photo Gallery: Albums + Photos ───────────────────────────
model Album {
  id        Int       @id @default(autoincrement())
  title     String
  category  String // maharaj, events
  cover     String?   @db.Text
  date      DateTime?
  published Boolean   @default(true)

  photos Photo[]

  @@index([published, category]) // public gallery listing
  @@map("albums")
}

model Photo {
  id        Int     @id @default(autoincrement())
  albumId   Int     @map("album_id")
  url       String  @db.Text
  caption   String?
  sortOrder Int     @default(0) @map("sort_order")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([albumId, sortOrder])
  @@map("photos")
}

// ── CMS Pages (माहिती) ───────────────────────────────────────
model Page {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @db.Text
  heroImage String?  @map("hero_image") @db.Text
  published Boolean  @default(true)
  updatedOn DateTime @default(now()) @updatedAt @map("updated_on")

  @@index([published])
  @@map("pages")
}

// ── Settings (key/value: about/terms/privacy docs, prefs) ────
model Setting {
  key   String @id
  value String @db.Text

  @@map("settings")
}

// ── Website content sections (CMS for the public website) ────
// One row per website section (maharaj, temple, trust, events,
// donate, story). `data` is a JSON document holding the section's
// structured, tri-lingual content ({ en, hi, mr } per text field).
// The admin edits in one language; the backend auto-translates the
// other two at save time, so the whole { en, hi, mr } shape is stored.
model SiteSection {
  key       String   @id // "maharaj" | "temple" | "trust" | "events" | "donate" | "story"
  data      String   @db.Text // JSON blob
  updatedOn DateTime @default(now()) @updatedAt @map("updated_on")

  @@map("site_sections")
}

// ── Pending mobile verification (website checkout OTP) ───────
// Deliberately separate from User. Pressing "Send OTP" must not create an
// account: the number is unproven at that point, and a mistyped digit would
// leave a permanent ghost row in the Users list. The account is created only
// once money actually clears, in checkout.verifyPayment().
//
// One row per phone number (upserted on resend). `verifiedAt` records a
// successful OTP check so the order step can require it.
model OtpChallenge {
  id         Int       @id @default(autoincrement())
  phone      String    @unique @db.VarChar(20)
  otp        String    @db.VarChar(10)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0) // wrong guesses against the current otp
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("otp_challenge")
}
