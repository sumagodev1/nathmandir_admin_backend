# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env itself is gitignored and must
# stay that way — it holds the database password, the JWT signing
# secret and the live Razorpay keys.
#
# Every value below is read at startup, so a change needs a
# restart (pm2 restart nathmandir-backend).
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME"

# ── Server ───────────────────────────────────────────────────
PORT=5000
# The public origin, used to turn a stored "/uploads/…" path into a full URL
# for the app. Set it in production: without it the origin is taken from the
# request, which is only https if the proxy forwards X-Forwarded-Proto.
PUBLIC_BASE_URL=https://api.example.com

# ── Auth ─────────────────────────────────────────────────────
# Signs both the admin panel session and the mobile app token. Changing it
# logs every admin and every phone out at once.
JWT_SECRET=change-me-to-a-long-random-string
# How long a checkout token stays valid (e.g. 15m, 1h).
CHECKOUT_JWT_EXPIRES=1h

# ── SMS (OTP delivery) ───────────────────────────────────────
# With no auth key the OTP is not sent but IS returned in the response, so
# local testing works without a gateway. Never leave it unset in production.
SMS_API_URL=
SMS_AUTH_KEY=
SMS_SENDER=
SMS_DLT_TEMPLATE_ID=
SMS_ROUTE=
SMS_COUNTRY=

# ── Razorpay ─────────────────────────────────────────────────
# Test keys start rzp_test_, live keys rzp_live_. The webhook secret is the
# one typed into the Razorpay dashboard, not the API secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Uploads ──────────────────────────────────────────────────
# Size caps in MB. Keep them at or below nginx's client_max_body_size (50M):
# nginx rejects a larger body before it reaches Node, and the admin then sees
# an HTML error page instead of a message explaining the limit.
# Omit either line to use the built-in default (audio 50, image 25).
UPLOAD_MAX_AUDIO_MB=50
UPLOAD_MAX_IMAGE_MB=25

# ── reCAPTCHA v2 (admin login) ───────────────────────────────
# The SECRET half of the key pair, from google.com/recaptcha/admin.
# It is only ever sent from this server to Google — never to the browser.
# The matching site key goes in the frontend's VITE_RECAPTCHA_SITE_KEY.
#
# Leave blank and the captcha check is skipped (a warning is logged). That is
# deliberate: making it mandatory would mean deploying this code before the
# value is set locks everybody out of the only admin account.
RECAPTCHA_SECRET_KEY=
