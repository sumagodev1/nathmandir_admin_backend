# The Prisma client is pre-generated and committed to src/generated/prisma,
# so `prisma generate` must NOT run on the (memory-limited) shared host.
# Skipping install scripts prevents @prisma/client's postinstall from running
# `prisma generate` (which OOMs on CloudLinux via its WebAssembly engine).
# No dependency here needs a native build step, so this is safe.
ignore-scripts=true
